# ---------------------------------------------------------------- TUI

C_DIM, C_SEL, C_WARN, C_OK, C_TITLE = 1, 2, 3, 4, 5


def init_colors() -> None:
    if not curses.has_colors():
        return
    curses.start_color()
    try:
        curses.use_default_colors()
        bg = -1
    except curses.error:
        bg = curses.COLOR_BLACK
    curses.init_pair(C_DIM, curses.COLOR_BLUE, bg)
    curses.init_pair(C_SEL, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(C_WARN, curses.COLOR_YELLOW, bg)
    curses.init_pair(C_OK, curses.COLOR_GREEN, bg)
    curses.init_pair(C_TITLE, curses.COLOR_CYAN, bg)


def attr(pair: int, extra: int = 0) -> int:
    try:
        return curses.color_pair(pair) | extra
    except curses.error:
        return extra


def confirm(stdscr, message: str) -> bool:
    h, w = stdscr.getmaxyx()
    lines = message.split("\n")
    box_h = len(lines) + 4
    box_w = max(len(l) for l in lines) + 6
    top, left = max(0, (h - box_h) // 2), max(0, (w - box_w) // 2)
    try:
        win = curses.newwin(box_h, box_w, top, left)
    except curses.error:
        return False
    win.bkgd(" ", attr(C_SEL))
    win.box()
    for i, line in enumerate(lines):
        win.addstr(1 + i, 3, line[: box_w - 4])
    win.addstr(box_h - 2, 3, "确认 [y/N] ")
    win.refresh()
    while True:
        ch = win.getch()
        if ch in (ord("y"), ord("Y")):
            return True
        if ch in (ord("n"), ord("N"), 27, ord("q")):
            return False


def proc_cwd(pid: int) -> str:
    """
    进程的工作目录 —— 「这个 claude 在哪个项目里干活」唯一可靠的来源。

    为什么不能用别的：
      - 内存数字（RSS）完全说明不了问题，它只是个数字；
      - comm 经常只给裸名。macOS 拿不到完整可执行路径时会退回 p_comm 那个
        16 字节字段，实测四个 claude 进程的 comm 全都是 "claude"，
        所以路径匹配实际上没生效，是 names=("claude",) 的兜底在起作用。
      - lsof 单次约 30ms，比 ps 慢一个数量级，所以只在进入详情视图时查一次
        并缓存，绝不能每帧都跑。
    """
    try:
        out = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                             capture_output=True, text=True, timeout=3).stdout
    except (subprocess.TimeoutExpired, OSError):
        return ""
    for line in out.splitlines():
        if line.startswith("n"):
            return line[1:].strip()
    return ""


# 进入详情视图时最多查多少个进程的 cwd：每个约 30ms，一次查太多会明显卡顿
CWD_LOOKUP_MAX = 12


def draw_bar(stdscr, y: int, x: int, width: int, frac: float, pair: int) -> None:
    """
    进度条只用 ASCII。

    踩过的坑：这里原本用的是 █ (U+2588) 和 ░ (U+2591)。它们的 East Asian Width
    都是 Ambiguous —— 在把「歧义字符按两列渲染」的终端里（CJK 字体设置常见），
    每个 █ 实际占 2 列，而本文件按 1 列算，24 个 █ 会撑成 48 列，把右边的文字
    全部盖掉，看起来就是一片乱码。ASCII 的宽度在任何终端里都没有歧义。
    """
    filled = max(0, min(width, int(width * frac)))
    try:
        stdscr.addstr(y, x, "#" * filled, attr(pair))
        stdscr.addstr(y, x + filled, "-" * (width - filled), attr(C_DIM))
    except curses.error:
        pass


def tui(stdscr, interval: float) -> None:
    curses.curs_set(0)
    init_colors()
    stdscr.timeout(int(interval * 1000))
    curses.mousemask(0)

    procs: list[Proc] = []
    sort_mode = 0
    sel = 0
    detail_of: str | None = None    # 非 None 表示在某个 harness 的进程列表里
    dsel = 0
    status = ""
    status_until = 0.0
    last_scan = 0.0
    cwd_cache: dict[int, str] = {}   # pid → 工作目录，进入详情时查一次

    while True:
        now = time.time()
        if now - last_scan > interval or not procs:
            procs = scan()
            last_scan = now
            # 清掉已经消失的 pid：不然 pid 被回收后会把旧的目录显示给新进程
            live = {p.pid for p in procs}
            for gone in [k for k in cwd_cache if k not in live]:
                del cwd_cache[gone]

        groups = sort_groups(group_procs(procs), SORTS[sort_mode][0])
        sel = max(0, min(sel, len(groups) - 1))

        stdscr.erase()
        h, w = stdscr.getmaxyx()
        mem = sys_mem()

        # ---- 标题栏
        title = f" control agent "
        try:
            stdscr.addstr(0, 0, title, attr(C_TITLE, curses.A_BOLD))
            right = (f"内存 {fmt_bytes(mem['total'])} | 已用 {fmt_bytes(mem['used'])}"
                     f" | 压缩 {fmt_bytes(mem.get('compressor', 0))} ")
            rw, tw = dwidth(right), dwidth(title)
            if rw < w - tw - 2:
                stdscr.addstr(0, w - rw - 1, right, attr(C_DIM))
            # 只画到 w-1：写到最后一个单元格会让 curses 抛错
            stdscr.addstr(1, 0, "-" * max(0, w - 1), attr(C_DIM))
        except curses.error:
            pass

        y = 2
        if detail_of is None:
            # ---- 分组视图
            hdr = ("  " + dpad("HARNESS", 16) + dpad("进程", 5, True)
                   + dpad("内存", 11, True) + dpad("CPU", 8, True) + "   占用分布")
            try:
                stdscr.addstr(y, 0, dtrunc(hdr, w - 1), attr(C_DIM)); y += 1
                stdscr.addstr(y, 0, "  " + "-" * max(0, w - 5), attr(C_DIM)); y += 1
            except curses.error:
                pass

            top_rss = max((g.rss_kb for g in groups), default=0)
            bar_w = max(8, min(24, w - 62))
            for i, g in enumerate(groups):
                if y >= h - 3:
                    break
                n = len(g.procs)
                if n:
                    mems, cpus = fmt_mb(g.rss_kb), f"{g.cpu:.1f}%"
                    np_ = g.protected_count
                    if np_ == n:
                        tail = "全部受保护（当前会话）"
                    elif np_:
                        tail = f"{np_} 个受保护"
                    else:
                        tail = ""
                else:
                    mems = cpus = "-"
                    tail = "未运行"
                line = ("  " + dpad(g.harness.label, 16)
                        + dpad(str(n) if n else "-", 5, True)
                        + dpad(mems, 11, True) + dpad(cpus, 8, True) + "   ")
                lw = dwidth(line)
                selected = (i == sel)
                try:
                    stdscr.addstr(y, 0, dtrunc(line, w - 1),
                                  attr(C_SEL) if selected else 0)
                    if n and bar_w > 4 and lw + bar_w < w - 1:
                        draw_bar(stdscr, y, lw, bar_w,
                                 g.rss_kb / top_rss if top_rss else 0,
                                 C_WARN if g.protected_count else C_OK)
                    if tail and lw + bar_w + dwidth(tail) + 2 < w - 1:
                        stdscr.addstr(y, lw + bar_w + 1, tail, attr(C_DIM))
                except curses.error:
                    pass
                y += 1
        else:
            # ---- 进程明细视图
            g = next((x for x in groups if x.harness.key == detail_of), None)
            try:
                dtitle = f"  > {g.harness.label} 的进程（{len(g.procs)}）" if g else ""
                # 表头列必须和数据行逐列对齐：数据行有 [保护] 这一列，表头漏掉的话
                # 「路径」会压在 [保护] 上方，看着像排版坏了。
                dhdr = ("  " + dpad("PID", 7, True) + dpad("内存", 11, True)
                        + dpad("CPU", 8, True) + "  "
                        + dpad("运行时长", 11) + dpad("保护", 7) + "工作目录")
                stdscr.addstr(y, 0, dtrunc(dtitle, w - 1), attr(C_TITLE)); y += 1
                stdscr.addstr(y, 0, dtrunc(dhdr, w - 1), attr(C_DIM)); y += 1
                stdscr.addstr(y, 0, "  " + "-" * max(0, w - 5), attr(C_DIM)); y += 1
            except curses.error:
                pass
            plist = sorted(g.procs, key=lambda p: -p.rss_kb) if g else []
            dsel = max(0, min(dsel, len(plist) - 1))
            for i, p in enumerate(plist):
                if y >= h - 3:
                    break
                # 用 [保护] 而不是 emoji：emoji 显示宽度不定，且不是所有终端都能渲染
                # 显示工作目录而不是 comm：claude 的 comm 只是个裸名 "claude"，
                # 目录才能说明这个进程在哪个项目里干活
                line = ("  " + dpad(str(p.pid), 7, True) + dpad(fmt_mb(p.rss_kb), 11, True)
                        + dpad(f"{p.cpu:.1f}%", 8, True) + "  "
                        + dpad(p.etime, 11) + dpad("[保护]" if p.protected else "", 7)
                        + (cwd_cache.get(p.pid) or p.comm))
                try:
                    stdscr.addstr(y, 0, dtrunc(line, w - 1), attr(C_SEL) if i == dsel else 0)
                except curses.error:
                    pass
                y += 1

        # ---- 状态栏
        if status and time.time() < status_until:
            try:
                stdscr.addstr(h - 2, 0, dtrunc(status, w - 1), attr(C_WARN))
            except curses.error:
                pass
        try:
            if detail_of is None:
                keys = (f"  方向键 选择   Enter 明细   k 杀掉选中   "
                        f"s 排序({SORTS[sort_mode][1]})   r 刷新   q 退出")
            else:
                keys = "  方向键 选择   k 杀掉选中进程   Esc/q 返回"
            stdscr.addstr(h - 1, 0, dtrunc(keys, w - 1), attr(C_TITLE))
        except curses.error:
            pass
        stdscr.refresh()

        # ---- 输入
        ch = stdscr.getch()
        if ch == -1:
            continue
        if ch == curses.KEY_RESIZE:
            continue

        if ch in (ord("q"), 27, curses.KEY_LEFT):
            if detail_of is not None:
                detail_of = None
            else:
                return
            continue

        # 移动只用方向键：k 已经分配给「杀」，再让 j/k 兼做移动会和杀操作撞车
        if ch == curses.KEY_UP:
            if detail_of is None:
                sel -= 1
            else:
                dsel -= 1
        elif ch == curses.KEY_DOWN:
            if detail_of is None:
                sel += 1
            else:
                dsel += 1
        elif ch == ord("s"):
            sort_mode = (sort_mode + 1) % len(SORTS)
            status = f"排序：{SORTS[sort_mode][1]}"
            status_until = time.time() + 1.5
        elif ch == ord("r"):
            procs = scan()
            last_scan = time.time()
            status = "已刷新"
            status_until = time.time() + 1.0
        elif ch in (10, 13, curses.KEY_RIGHT, ord("l")):
            if detail_of is None:
                if groups[sel].procs:
                    detail_of = groups[sel].harness.key
                    dsel = 0
                    # 在这里一次查完，而不是渲染时按需查：每帧几十毫秒会明显卡
                    for p in groups[sel].procs[:CWD_LOOKUP_MAX]:
                        cwd_cache.setdefault(p.pid, proc_cwd(p.pid))
        elif ch == ord("k"):
            if detail_of is None:
                g = groups[sel]
                killable = [p for p in g.procs if not p.protected]
                if not g.procs:
                    status, status_until = "该 harness 未运行", time.time() + 2
                elif not killable:
                    status = "受保护：这些进程属于当前会话，杀掉会终止你自己"
                    status_until = time.time() + 3
                else:
                    skipped = len(g.procs) - len(killable)
                    msg = f"杀掉 {g.harness.label} 的 {len(killable)} 个进程？"
                    if skipped:
                        msg += f"\n（跳过 {skipped} 个受保护的当前会话进程）"
                    if confirm(stdscr, msg):
                        gone, errs = kill_pids([p.pid for p in killable])
                        procs = scan()
                        last_scan = time.time()
                        status = f"已终止 {len(gone)} 个"
                        if errs:
                            status += f"；{len(errs)} 个失败：{errs[0]}"
                        status_until = time.time() + 4
                    else:
                        status, status_until = "已取消", time.time() + 1.5
            else:
                g = next((x for x in groups if x.harness.key == detail_of), None)
                plist = sorted(g.procs, key=lambda p: -p.rss_kb) if g else []
                if plist:
                    p = plist[dsel]
                    if p.protected:
                        status = "受保护：这是当前会话的进程，杀掉会终止你自己"
                        status_until = time.time() + 3
                    elif confirm(stdscr, f"杀掉 pid {p.pid}？\n{p.comm}"):
                        gone, errs = kill_pids([p.pid])
                        procs = scan()
                        last_scan = time.time()
                        status = f"已终止 {len(gone)} 个" + (f"；{errs[0]}" if errs else "")
                        status_until = time.time() + 4
                        if not gone:
                            detail_of = None
                    else:
                        status, status_until = "已取消", time.time() + 1.5


def main() -> int:
    args = sys.argv[1:]
    interval = 2.0
    if "--interval" in args:
        i = args.index("--interval")
        try:
            interval = float(args[i + 1])
        except (IndexError, ValueError):
            print("--interval 需要数字", file=sys.stderr)
            return 2

    procs = scan()
    if "--list" in args:
        print_list()
        return 0
    if "--json" in args:
        print_json(procs)
        return 0
    if "--once" in args or not sys.stdout.isatty():
        print_table(procs)
        return 0

    try:
        curses.wrapper(lambda s: tui(s, interval))
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())

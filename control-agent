# ---------------------------------------------------------------- 进程采集


@dataclass
class Proc:
    pid: int
    ppid: int
    rss_kb: int
    cpu: float
    etime: str
    comm: str
    argv: str
    harness: str | None = None
    protected: bool = False   # 当前会话的祖先链，杀了会把自己弄死


def read_procs() -> list[Proc]:
    """
    分两次 ps 调用再按 pid 合并。

    踩过的坑：一旦在同一个 ps 里同时请求 comm 和 command，macOS 会把 comm 截断到
    16 字符 —— /Users/pka/.kimi-webbridge/bin/kimi-webbridge 变成 /Users/pka/.kimi，
    所有路径匹配就全废了。单独取 comm 才完整，因此这里分两次拿。
    """
    def run(args: list[str]) -> str:
        try:
            return subprocess.run(args, capture_output=True, text=True, timeout=10).stdout
        except (subprocess.TimeoutExpired, OSError):
            return ""

    comm_by_pid: dict[int, str] = {}
    for line in run(["ps", "-Ao", "pid=,comm="]).splitlines():
        head, _, tail = line.strip().partition(" ")
        if head.isdigit() and tail.strip():
            comm_by_pid[int(head)] = tail.strip()

    procs = []
    for line in run(["ps", "-Ao", "pid=,ppid=,rss=,pcpu=,etime=,command="]).splitlines():
        parts = line.split(None, 5)          # command 可能含空格，限制切分次数
        if len(parts) < 6:
            continue
        pid_s, ppid_s, rss_s, cpu_s, etime, argv = parts
        try:
            pid, ppid, rss = int(pid_s), int(ppid_s), int(rss_s)
        except ValueError:
            continue
        if pid <= 1:
            continue
        procs.append(Proc(pid, ppid, rss, float(cpu_s or 0), etime,
                          comm_by_pid.get(pid, argv), argv))
    return procs


def ancestor_chain(procs: list[Proc]) -> set[int]:
    """
    当前进程往上到 launchd 的整条祖先链。

    多半是从 claude 会话里跑这个 TUI 的 —— 如果杀掉 claude 整组却把自己的会话
    也算进去，TUI 会当场把自己弄死，所以这些 pid 必须标记为受保护。
    """
    ppid_of = {p.pid: p.ppid for p in procs}
    chain, pid = {os.getpid()}, os.getpid()
    for _ in range(64):
        nxt = ppid_of.get(pid)
        if not nxt or nxt <= 1 or nxt in chain:
            break
        chain.add(nxt)
        pid = nxt
    return chain


def classify(p: Proc) -> str | None:
    comm, argv = p.comm, p.argv
    if comm.startswith(SYSTEM_PREFIXES):
        return None
    if os.path.basename(comm) in SYSTEM_BASENAMES:
        return None
    base = os.path.basename(comm).lower()
    for h in HARNESSES:
        for pat in h.paths:
            if pat in comm:
                return h.key
        if base in h.names:
            return h.key
    for h in HARNESSES:
        for pat in h.argv:
            if pat in argv:
                return h.key
    return None


def scan() -> list[Proc]:
    procs = read_procs()
    prot = ancestor_chain(procs)
    for p in procs:
        p.harness = classify(p)
        p.protected = p.pid in prot
    return [p for p in procs if p.harness]


# ---------------------------------------------------------------- 系统内存


def sys_mem() -> dict:
    """总内存 + vm_stat 关键页数。压缩器占用是 16G 机器上最关键的信号。"""
    total = 0
    try:
        total = int(subprocess.run(["sysctl", "-n", "hw.memsize"],
                                   capture_output=True, text=True, timeout=5).stdout.strip())
    except (ValueError, OSError, subprocess.TimeoutExpired):
        pass
    page = os.sysconf("SC_PAGE_SIZE")
    want = {
        "Pages free": "free",
        "Pages active": "active",
        "Pages wired down": "wired",
        "Pages occupied by compressor": "compressor",
    }
    stats = {}
    try:
        vm = subprocess.run(["vm_stat"], capture_output=True, text=True, timeout=5).stdout
        for line in vm.splitlines():
            for k, v in want.items():
                if line.startswith(k):
                    m = re.search(r":\s*(\d+)", line)
                    if m:
                        stats[v] = int(m.group(1)) * page
    except (OSError, subprocess.TimeoutExpired):
        pass
    used = stats.get("active", 0) + stats.get("wired", 0) + stats.get("compressor", 0)
    return {"total": total, "used": used, **stats}


def fmt_bytes(n: int) -> str:
    if not n:
        return "—"
    for unit, div in (("G", 1 << 30), ("M", 1 << 20), ("K", 1 << 10)):
        if n >= div:
            return f"{n / div:.2f} {unit}B" if unit != "K" else f"{n / div:.0f} KB"
    return f"{n} B"


def fmt_mb(kb: int) -> str:
    return fmt_bytes(kb * 1024)


def dwidth(s: str) -> int:
    """终端显示宽度。CJK 全角字符占 2 列 —— 用 len() 会让含中文的表格整体错位。"""
    return sum(2 if unicodedata.east_asian_width(c) in ("W", "F") else 1 for c in s)


def dpad(s: str, width: int, right: bool = False) -> str:
    pad = " " * max(0, width - dwidth(s))
    return pad + s if right else s + pad


def dtrunc(s: str, width: int) -> str:
    """按显示宽度截断，避免写到行尾触发 curses.error。"""
    out, acc = [], 0
    for c in s:
        cw = 2 if unicodedata.east_asian_width(c) in ("W", "F") else 1
        if acc + cw > width:
            break
        out.append(c)
        acc += cw
    return "".join(out)


# ---------------------------------------------------------------- 分组


@dataclass
class Group:
    harness: Harness
    procs: list[Proc] = field(default_factory=list)

    @property
    def rss_kb(self) -> int:
        return sum(p.rss_kb for p in self.procs)

    @property
    def cpu(self) -> float:
        return sum(p.cpu for p in self.procs)

    @property
    def protected_count(self) -> int:
        return sum(1 for p in self.procs if p.protected)

    @property
    def protected_only(self) -> bool:
        return bool(self.procs) and self.protected_count == len(self.procs)


def group_procs(procs: list[Proc]) -> list[Group]:
    groups = {h.key: Group(h) for h in HARNESSES}
    for p in procs:
        groups[p.harness].procs.append(p)
    return list(groups.values())


SORTS = [("mem", "内存"), ("cpu", "CPU"), ("name", "名称")]
SORT_KEYS = {"mem": lambda g: -g.rss_kb,
             "cpu": lambda g: -g.cpu,
             "name": lambda g: g.harness.label.lower()}


def sort_groups(groups: list[Group], mode: str) -> list[Group]:
    # 未运行的沉底，运行的按选定维度排
    return sorted(groups, key=lambda g: (not g.procs, SORT_KEYS[mode](g)))


# ---------------------------------------------------------------- 杀进程


def kill_pids(pids: list[int], grace: float = 2.0) -> tuple[list[int], list[str]]:
    """SIGTERM → 宽限期 → 对残留的补 SIGKILL。返回 (已退出, 失败原因)。"""
    errors = []
    alive = []
    for pid in pids:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        except PermissionError:
            errors.append(f"pid {pid}: 权限不足（属于其他用户，需要 sudo）")
        else:
            alive.append(pid)

    deadline = time.time() + grace
    while alive and time.time() < deadline:
        time.sleep(0.1)
        alive = [p for p in alive if _alive(p)]

    for pid in list(alive):
        try:
            os.kill(pid, signal.SIGKILL)
        except (ProcessLookupError, PermissionError) as e:
            errors.append(f"pid {pid}: SIGKILL 失败 ({e.__class__.__name__})")

    time.sleep(0.2)
    remaining = [p for p in pids if _alive(p)]
    gone = [p for p in pids if p not in remaining]
    return gone, errors


def _alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


# ---------------------------------------------------------------- 非交互输出


def print_table(procs: list[Proc]) -> None:
    groups = sort_groups(group_procs(procs), "mem")
    mem = sys_mem()
    if mem["total"]:
        print(f"内存 {fmt_bytes(mem['total'])} | 已用 {fmt_bytes(mem['used'])}"
              f" | 压缩 {fmt_bytes(mem.get('compressor', 0))}"
              f" | 空闲 {fmt_bytes(mem.get('free', 0))}")
    print("  " + dpad("HARNESS", 16) + dpad("进程", 5, True) + dpad("内存", 11, True)
          + dpad("CPU", 8, True) + "   状态")
    print("-" * 62)
    total_n = total_kb = 0
    for g in groups:
        n, kb = len(g.procs), g.rss_kb
        total_n += n
        total_kb += kb
        if n:
            np_ = g.protected_count
            if np_ == n:
                flag = "全部受保护（当前会话）"
            elif np_:
                flag = f"运行中（{np_} 个受保护）"
            else:
                flag = "运行中"
            print("  " + dpad(g.harness.label, 16) + dpad(str(n), 5, True)
                  + dpad(fmt_mb(kb), 11, True) + dpad(f"{g.cpu:.1f}%", 8, True) + "   " + flag)
        else:
            print("  " + dpad(g.harness.label, 16) + dpad("-", 5, True)
                  + dpad("-", 11, True) + dpad("-", 8, True) + "   未运行")
    print("-" * 62)
    print("  " + dpad("合计", 16) + dpad(str(total_n), 5, True) + dpad(fmt_mb(total_kb), 11, True))


def print_json(procs: list[Proc]) -> None:
    groups = sort_groups(group_procs(procs), "mem")
    mem = sys_mem()
    out = {
        "system_memory": mem,
        "harnesses": [
            {
                "key": g.harness.key,
                "label": g.harness.label,
                "count": len(g.procs),
                "rss_bytes": g.rss_kb * 1024,
                "cpu_percent": round(g.cpu, 1),
                "protected_only": g.protected_only,
                "processes": [
                    {"pid": p.pid, "rss_bytes": p.rss_kb * 1024, "cpu": p.cpu,
                     "etime": p.etime, "protected": p.protected, "comm": p.comm}
                    for p in sorted(g.procs, key=lambda p: -p.rss_kb)
                ],
            }
            for g in groups
        ],
    }
    print(json.dumps(out, ensure_ascii=False, indent=2))



# ---------------------------------------------------------------- TUI

C_DIM, C_SEL, C_WARN, C_OK, C_TITLE = 1, 2, 3, 4, 5


def init_colors() -> None:
    if not curses.has_colors():
        return
    curses.start_color()
    try:
        curses.use_default_colors()
        bg = -1
    except curses.error:
        bg = curses.COLOR_BLACK
    curses.init_pair(C_DIM, curses.COLOR_BLUE, bg)
    curses.init_pair(C_SEL, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(C_WARN, curses.COLOR_YELLOW, bg)
    curses.init_pair(C_OK, curses.COLOR_GREEN, bg)
    curses.init_pair(C_TITLE, curses.COLOR_CYAN, bg)


def attr(pair: int, extra: int = 0) -> int:
    try:
        return curses.color_pair(pair) | extra
    except curses.error:
        return extra


def confirm(stdscr, message: str) -> bool:
    h, w = stdscr.getmaxyx()
    lines = message.split("\n")
    box_h = len(lines) + 4
    box_w = max(len(l) for l in lines) + 6
    top, left = max(0, (h - box_h) // 2), max(0, (w - box_w) // 2)
    try:
        win = curses.newwin(box_h, box_w, top, left)
    except curses.error:
        return False
    win.bkgd(" ", attr(C_SEL))
    win.box()
    for i, line in enumerate(lines):
        win.addstr(1 + i, 3, line[: box_w - 4])
    win.addstr(box_h - 2, 3, "确认 [y/N] ")
    win.refresh()
    while True:
        ch = win.getch()
        if ch in (ord("y"), ord("Y")):
            return True
        if ch in (ord("n"), ord("N"), 27, ord("q")):
            return False


def parse_etime(s: str) -> float:
    """
    ps 的 etime（已运行时长）换算成秒。三种格式：MM:SS、HH:MM:SS、D-HH:MM:SS。

    为什么绕这一圈而不直接问 ps 要启动时间：
      - macOS 的 ps **没有 etimes 关键字**（实测 `ps: etimes: keyword not found`），
        拿不到「已运行秒数」这个现成字段；
      - `ps -o lstart=` 能用，但它**受 locale 影响** —— 在 LC_ALL=zh_CN.UTF-8 下
        输出的是「日  9月/20 18:13:35 2026」，strptime("%a %b %d %H:%M:%S %Y")
        当场抛异常。强制 LC_ALL=C 可以绕开，但那是每个进程一次额外 subprocess。
      - etime 是 locale 无关的纯数字格式，而且 read_procs() 本来就已经把它
        存进 Proc.etime 了，所以这条路是零额外开销的。

    实测：now - parse_etime(etime) 与 lstart 相差 +0.3s（那 0.3s 就是 ps 调用本身
    的耗时），相对 SESSION_MATCH_TOL 的容差完全够用。
    """
    s = s.strip()
    days = 0
    if "-" in s:
        head, _, s = s.partition("-")
        try:
            days = int(head)
        except ValueError:
            return 0.0
    try:
        parts = [int(x) for x in s.split(":")]
    except ValueError:
        return 0.0
    while len(parts) < 3:
        parts.insert(0, 0)
    h, m, sec = parts[-3], parts[-2], parts[-1]
    return float(days * 86400 + h * 3600 + m * 60 + sec)


def proc_start_ts(p: "Proc") -> float:
    """由 etime 反推进程的启动时刻（Unix 秒）。"""
    return time.time() - parse_etime(p.etime)


# history.jsonl 的索引缓存：(mtime, size, 上次读取时刻, 索引)
_hist_cache: tuple[float, int, float, dict] | None = None


def load_history(force: bool = False) -> dict:
    """
    读 ~/.claude/history.jsonl，返回 project -> {sid: [(ts_ms, display), ...]}，按时间升序。

    这个文件同时解决两件事：进程对到哪个会话（用时间戳），以及「最近提问」显示什么
    （用 display）。5.8 万行，解析一次约 90ms，所以必须缓存 —— 而且不能只按
    mtime 判断：用户正在用 Claude Code 时每条 prompt 都会改这个文件，那样等于
    每次重扫都重解析一遍。所以叠加一个 HISTORY_TTL 最小间隔。
    """
    global _hist_cache
    try:
        st = os.stat(HISTORY_FILE)
        key = (st.st_mtime, st.st_size)
    except OSError:
        return {}

    now = time.time()
    if _hist_cache and not force:
        mtime, size, read_at, idx = _hist_cache
        if (mtime, size) == key or now - read_at < HISTORY_TTL:
            return idx

    idx: dict[str, dict[str, list]] = {}
    try:
        with open(HISTORY_FILE, encoding="utf-8", errors="replace") as f:
            for line in f:
                # 快路径：这行没有 "project" 就不可能是我们要的记录，省掉 json.loads
                if '"project"' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                proj, sid = rec.get("project"), rec.get("sessionId")
                ts = rec.get("timestamp")
                if not (proj and sid and ts):
                    continue
                idx.setdefault(proj, {}).setdefault(sid, []).append((ts, rec.get("display", "")))
    except OSError:
        return _hist_cache[3] if _hist_cache else {}

    for sessions in idx.values():
        for entries in sessions.values():
            entries.sort()

    _hist_cache = (key[0], key[1], now, idx)
    return idx


def claude_session_file(sid: str) -> str:
    """
    按会话 id 找它的 jsonl 文件。

    这里刻意**不复刻** Claude Code 那条「把 cwd 里的 / 换成 -」的目录命名规则，
    而是直接 glob 会话 id：那条规则遇到路径里本来就有的 "-" 是有歧义的
    （~/Downloads/new-api 会变成 -Users-pka-Downloads-new-api，和真实含 - 的
    目录名撞车），而会话 id 全局唯一，绕开整个问题。
    """
    if not sid:
        return ""
    hits = glob.glob(os.path.join(PROJECTS_DIR, "*", sid + ".jsonl"))
    return hits[0] if hits else ""


def session_stats(sid: str, path: str = "") -> dict | None:
    """
    解析一个会话文件，汇总 token 用量、模型名、消息数与标题。实测 15-29ms（8MB 文件）。

    token 字段在每条 assistant 记录的 message.usage 里；<synthetic> 是系统注入的
    合成消息，实测它们四个 token 字段全是 0，直接跳过免得污染模型名的统计。

    path 留空时才走 claude_session_file() 的 glob —— 调用方已经拿着确切路径时
    （历史会话浏览就是这么用的），省掉一次全目录扫描。
    """
    if not path:
        path = claude_session_file(sid)
    if not path:
        return None

    tokens = {"input_tokens": 0, "output_tokens": 0,
              "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0}
    model_count: dict[str, int] = {}
    msgs = 0
    title = ""
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                if '"aiTitle"' in line:
                    try:
                        title = json.loads(line).get("aiTitle") or title
                    except ValueError:
                        pass
                # 快路径：绝大多数记录（user / attachment / file-history-*）没有 usage，
                # 先用子串筛掉，能省下大量 json.loads
                if '"usage"' not in line:
                    continue
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                msg = rec.get("message")
                if not isinstance(msg, dict):
                    continue
                usage = msg.get("usage")
                if not usage:
                    continue
                model = msg.get("model") or "?"
                if model == "<synthetic>":
                    continue
                msgs += 1
                model_count[model] = model_count.get(model, 0) + 1
                for k in tokens:
                    tokens[k] += usage.get(k, 0) or 0
    except OSError:
        return None

    model = max(model_count, key=lambda k: model_count[k]) if model_count else "?"
    return {"tokens": tokens, "model": model, "msgs": msgs, "title": title}


def resolve_session(p: "Proc", cwd: str, hist: dict) -> tuple[str, str, float]:
    """
    把进程对到它正在跑的那个会话，返回 (sid, 确定性, 偏差秒数)。

    判据是「进程启动时刻 ≈ 该会话在 history.jsonl 里的首次活动时刻」。

    为什么不能用「这个目录下最近活动的会话」：实测 ~/Downloads/new-api 下同时跑着
    两个 claude（pid 8124 和 18465），那个朴素启发式会把它们映射到同一个会话，
    token 数直接翻倍。启动时间才是每个进程独有的。

    两条实测出来的过滤规则，都不是想当然：
      1. 只有斜杠命令的会话要排除。`/resume`、`/model` 这类命令不产生 assistant
         轮次，于是落盘文件根本不存在，但它们在 history.jsonl 里是一条**独立的新
         会话 id**。实测 pid 8124 是 `--resume` 启动的，它对应的那个 shell 会话
         cba5b88e 只有一条 `/resume` 记录、偏差只有 +3s —— 不排掉的话它会以
         「偏差最小」赢下比赛，而这个会话其实什么都不是。
      2. 会话首次活动远晚于进程启动的，属于**更晚启动的那个进程**。pid 8124 启动于
         10:17，而 04f50f8b 首次活动是 10:38:51（那是 pid 18465 的会话）—— 不排除
         的话 8124 会去认领它。但这条只是「不可信」而非「不可能」（用户可能启动后
         十分钟才打第一个字），所以降级到备选池而**不是**直接丢掉。

    确定性只有两种，不装确定：
      - 确认：偏差 <= SESSION_MATCH_TOL，且没有第二个候选也落在这个范围内；
      - 推测：其余情况。`claude --resume` 复用的旧会话首次活动远早于进程启动，
        必然落到这里 —— 这时面板会显示偏差秒数，让用户自己判断。
    """
    sessions = hist.get(cwd) or {}
    if not sessions:
        return "", "无会话", 0.0

    start = proc_start_ts(p)
    trusted, fallback = [], []
    for sid, entries in sessions.items():
        if not entries:
            continue
        first = entries[0][0] / 1000.0
        last = entries[-1][0] / 1000.0
        # 会话的最后活动早于进程启动，就不可能是它在跑
        if last < start - SESSION_MATCH_TOL:
            continue
        # 整段历史只有斜杠命令 —— 命令回显，不是真的工作会话
        if all(str(d).lstrip().startswith("/") for _, d in entries):
            continue
        delta = abs(first - start)
        (trusted if first <= start + SESSION_MATCH_TOL else fallback).append((delta, sid))

    pool = trusted or fallback
    if not pool:
        return "", "无会话", 0.0

    pool.sort()
    delta, sid = pool[0]
    if trusted and delta <= SESSION_MATCH_TOL:
        # 两个候选一样近 —— 同目录多会话并发，老实说不确定
        if len(pool) > 1 and pool[1][0] <= SESSION_MATCH_TOL:
            return sid, "推测", delta
        return sid, "确认", delta
    return sid, "推测", delta


def session_panel(p: "Proc", cwd: str) -> dict:
    """组装一个进程的会话面板数据。查不到就返回带说明的 dict，不留空。"""
    if p.harness != "claude":
        return {"note": "该 harness 暂时没有可解析的会话数据（目前只有 Claude Code 有）"}
    if not cwd:
        return {"note": "查不到工作目录，无法定位会话"}
    if not os.path.isdir(PROJECTS_DIR):
        return {"note": f"没有 {PROJECTS_DIR}，本机没跑过 Claude Code？"}

    hist = load_history()
    sid, conf, delta = resolve_session(p, cwd, hist)
    if not sid:
        return {"note": f"这个目录下没有找到匹配的会话（{cwd}）"}

    stats = session_stats(sid)
    if stats is None:
        # 会话在 history 里存在但文件还没落盘：只有「刚提问、还没产生 assistant 轮次」
        # 会这样。不要说成「刚启动」—— 实测有个跑了 8.7 小时的进程也走到过这里。
        return {"note": f"会话 {sid[:8]} ({conf}) 还没有落盘内容，可能刚提问、模型还没回完",
                "sid": sid, "conf": conf}

    prompts = [d for _, d in (hist.get(cwd, {}).get(sid) or [])][-PROMPT_ROWS:]
    return {"sid": sid, "conf": conf, "delta": delta, "prompts": prompts, **stats}


def proc_cwd(pid: int) -> str:
    """
    进程的工作目录 —— 「这个 claude 在哪个项目里干活」唯一可靠的来源。

    为什么不能用别的：
      - 内存数字（RSS）完全说明不了问题，它只是个数字；
      - comm 经常只给裸名。macOS 拿不到完整可执行路径时会退回 p_comm 那个
        16 字节字段，实测四个 claude 进程的 comm 全都是 "claude"，
        所以路径匹配实际上没生效，是 names=("claude",) 的兜底在起作用。
      - lsof 单次约 30ms，比 ps 慢一个数量级，所以只在进入详情视图时查一次
        并缓存，绝不能每帧都跑。
    """
    try:
        out = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"],
                             capture_output=True, text=True, timeout=3).stdout
    except (subprocess.TimeoutExpired, OSError):
        return ""
    for line in out.splitlines():
        if line.startswith("n"):
            return line[1:].strip()
    return ""


# 进入详情视图时最多查多少个进程的 cwd：每个约 30ms，一次查太多会明显卡顿
CWD_LOOKUP_MAX = 12


# ---------------------------------------------------------------- 历史会话浏览


@dataclass
class SessionRow:
    """一条历史会话。agent TUI 只看得到「正在跑」的进程，这里看的是磁盘上的全部。"""
    sid: str
    path: str                 # 落盘的 jsonl 路径
    project: str              # 会话的项目目录（优先取 history.jsonl 的原始路径）
    mtime: float              # 文件最后修改时间，排序主键
    size: int
    prompts: list = field(default_factory=list)   # 该会话全部提问（含斜杠命令）
    title: str = ""           # aiTitle，懒加载（要读整个文件）
    stats: dict | None = None  # token 统计，懒加载；解析失败时为 {"failed": True} 防止重试
    hay: str = ""             # 搜索用的全文本（标题+提问+项目+sid），懒构建


def decode_project_dir(name: str) -> str:
    """
    把 projects/ 下的目录名尽力解码回路径，只服务于极少数不在 history.jsonl 里的会话。

    Claude Code 的编码是把 cwd 里的 / 换成 -，这个变换不可逆：com~apple~CloudDocs
    会变成 com-apple-CloudDocs，还原时 - 到底原来是 / 还是 - 无从判断。history.jsonl
    的 project 字段存的是原始路径，所以主路径永远从那里取，这里只是兜底。
    """
    s = name.replace("-", "/")
    return s if s.startswith("/") else "/" + s


def collect_sessions() -> list[SessionRow]:
    """
    列出所有历史会话：projects/*/*.jsonl 是事实来源（启动了但一个字没敲就退出的会话
    不会进 history.jsonl，但仍占着文件）；history.jsonl 负责补充精确的项目路径、
    首末活动时间和提问列表。全量 87 个文件、173MB 的实测规模下，这里只做 scandir，
    一个文件都不读，耗时 <10ms —— 读文件是后面按可见行懒加载的事。
    """
    by_sid: dict[str, tuple[str, list]] = {}
    for proj, sessions in load_history().items():
        for sid, entries in sessions.items():
            if entries:
                by_sid[sid] = (proj, [d for _, d in entries])

    rows: list[SessionRow] = []
    try:
        pdirs = sorted(os.scandir(PROJECTS_DIR), key=lambda e: e.name)
    except OSError:
        return rows
    for d in pdirs:
        if not d.is_dir():
            continue
        try:
            files = sorted(os.scandir(d.path), key=lambda e: e.name)
        except OSError:
            continue
        for f in files:
            if not f.name.endswith(".jsonl") or f.name.startswith("."):
                continue
            try:
                st = f.stat()
            except OSError:
                continue
            sid = f.name[:-6]
            proj, prompts = by_sid.get(sid, ("", []))
            rows.append(SessionRow(sid, f.path, proj or decode_project_dir(d.name),
                                   st.st_mtime, st.st_size, prompts))
    return rows


def session_cwd_from_file(path: str) -> str:
    """
    从会话文件头几条记录里读 cwd（Enter 恢复会话时，项目目录已不存在的情况下才用）。

    不能只读第一行：实测第一行往往是 {"type":"mode"} 这类元信息，cwd 在第一条
    message 记录里。也不设硬上限直接全读 —— 特意限定条数，正常会话头几行必然命中。
    """
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for _, line in zip(range(40), f):
                if '"cwd"' not in line:
                    continue
                try:
                    cwd = json.loads(line).get("cwd")
                except ValueError:
                    continue
                if cwd:
                    return cwd
    except OSError:
        pass
    return ""


def row_hay(r: SessionRow) -> str:
    """搜索索引。标题懒加载完成后由调用方清掉 r.hay 触发重建。"""
    if not r.hay:
        r.hay = (r.title + "\n" + "\n".join(str(d) for d in r.prompts)
                 + "\n" + r.project + " " + r.sid).lower()
    return r.hay


def row_match(r: SessionRow, q: str) -> bool:
    """多词按空格分隔、AND 语义 —— 搜「haruka readme」想找的是同时提到两者的会话。"""
    if not q:
        return True
    hay = row_hay(r)
    return all(word in hay for word in q.lower().split())


def row_text(r: SessionRow) -> tuple[str, str, str]:
    """列表行的三要素：时间 / 标题（或最近提问）/ 项目路径（~ 缩写）。"""
    t = time.localtime(r.mtime)
    if t.tm_year == time.localtime().tm_year:
        when = time.strftime("%m-%d %H:%M", t)
    else:
        when = time.strftime("%Y-%m-%d", t)
    home = os.path.expanduser("~")
    if r.project == home:
        proj = "~"
    elif r.project.startswith(home + "/"):
        proj = "~" + r.project[len(home):]
    else:
        proj = r.project
    meaningful = [d for d in r.prompts if not str(d).lstrip().startswith("/")]
    source = meaningful or r.prompts
    text = str(r.title or (source[-1] if source else "") or "(无标题，无提问)")
    return when, text, proj


def print_history_table(rows: list[SessionRow]) -> None:
    """非交互（管道）下的 history 输出：按修改时间倒序的前 30 条。"""
    rows = sorted(rows, key=lambda r: -r.mtime)
    print(f"共 {len(rows)} 个会话（按最后修改时间倒序，只显示前 30 条）")
    print("  " + dpad("时间", 12) + dpad("标题 / 最近提问", 44) + "项目")
    print("  " + "-" * 78)
    for r in rows[:30]:
        when, text, proj = row_text(r)
        text = next((ln.strip() for ln in text.splitlines() if ln.strip()), "")
        print("  " + dpad(when, 12) + dpad(dtrunc(text, 44), 44) + proj)
    if len(rows) > 30:
        print(f"  … 其余 {len(rows) - 30} 条未显示")


def draw_bar(stdscr, y: int, x: int, width: int, frac: float, pair: int) -> None:
    """
    进度条只用 ASCII。

    踩过的坑：这里原本用的是 █ (U+2588) 和 ░ (U+2591)。它们的 East Asian Width
    都是 Ambiguous —— 在把「歧义字符按两列渲染」的终端里（CJK 字体设置常见），
    每个 █ 实际占 2 列，而本文件按 1 列算，24 个 █ 会撑成 48 列，把右边的文字
    全部盖掉，看起来就是一片乱码。ASCII 的宽度在任何终端里都没有歧义。
    """
    filled = max(0, min(width, int(width * frac)))
    try:
        stdscr.addstr(y, x, "#" * filled, attr(pair))
        stdscr.addstr(y, x + filled, "-" * (width - filled), attr(C_DIM))
    except curses.error:
        pass


def fmt_tokens(n: int) -> str:
    """token 数带千分位。用 ASCII 逗号，理由同「结构性字符一律 ASCII」。"""
    return f"{n:,}"


def draw_session_panel(stdscr, y: int, w: int, info: dict, cwd: str) -> int:
    """
    画选中进程的会话面板（token 用量 + 标题 + 最近提问），返回下一行的 y。

    只对「当前选中的那一个 pid」调用 —— 一次解析 15-30ms，每帧都算会明显卡顿。
    """
    def put(row: int, text: str, pair: int = 0) -> None:
        try:
            stdscr.addstr(row, 0, dtrunc(text, w - 1), attr(pair))
        except curses.error:
            pass

    note = info.get("note")
    if note:
        put(y, f"  --- {note}", C_WARN)
        return y + 1

    sid = info.get("sid", "")
    conf = info.get("conf", "")
    delta = info.get("delta") or 0.0
    tok = info.get("tokens") or {}

    # 「推测」不装确定：--continue/--resume 会复用旧会话，判据本身就会失准
    mark = f"{conf} 偏差{delta:+.0f}s" if conf == "推测" else conf
    put(y, f"  --- 会话 {sid[:8]} ({mark})   模型 {info.get('model', '?')}"
           f"   消息 {info.get('msgs', 0)} ---", C_TITLE)
    y += 1
    put(y, "  " + "输入 " + fmt_tokens(tok.get("input_tokens", 0))
           + "   输出 " + fmt_tokens(tok.get("output_tokens", 0))
           + "   缓存读 " + fmt_tokens(tok.get("cache_read_input_tokens", 0))
           + "   缓存写 " + fmt_tokens(tok.get("cache_creation_input_tokens", 0)))
    y += 1
    put(y, "  合计 " + fmt_tokens(sum(tok.values())) + " tokens"
           + (f"     目录 {cwd}" if cwd else ""), C_DIM)
    y += 1

    if info.get("title"):
        put(y, f"  标题 {info['title']}")
        y += 1
    prompts = info.get("prompts") or []
    if prompts:
        put(y, "  最近提问", C_DIM)
        y += 1
        for entry in prompts:
            # display 可能是多行的（用户粘贴过换行），只取第一行非空内容
            text = next((ln.strip() for ln in str(entry).splitlines() if ln.strip()), "")
            put(y, f"    {text}")
            y += 1
    return y


def tui(stdscr, interval: float) -> None:
    curses.curs_set(0)
    init_colors()
    stdscr.timeout(int(interval * 1000))
    curses.mousemask(0)

    procs: list[Proc] = []
    sort_mode = 0
    sel = 0
    sel_key: str | None = None       # 主列表选中的 harness key（锚点，见渲染处说明）
    detail_of: str | None = None    # 非 None 表示在某个 harness 的进程列表里
    dsel = 0
    dsel_pid: int | None = None      # 详情页选中的 pid（同样是锚点）
    status = ""
    status_until = 0.0
    last_scan = 0.0
    cwd_cache: dict[int, str] = {}   # pid → 工作目录，进入详情时查一次
    sess_cache: dict[int, dict] = {}  # pid → 会话面板数据，同样是按需算一次
    show_panel = True                 # t 键切换
    dtop = 0                          # 详情列表的滚动偏移
    # 渲染时算好的列表，供按键处理里把「锚点」同步到新选中项 —— 见下方 ↓/↑ 的说明
    dgroups: list = []
    dplist: list = []

    while True:
        now = time.time()
        # 只在「重新采集过」的那一帧做选择锚定。若每帧都锚，用户按 ↓ 改掉的 dsel
        # 会被立刻按旧 pid 算回去，选择直接冻住（实测连按 6 次 ↓ 纹丝不动）。
        rescanned = False
        if now - last_scan > interval or not procs:
            procs = scan()
            last_scan = now
            rescanned = True
            # 清掉已经消失的 pid：不然 pid 被回收后会把旧的目录/会话显示给新进程
            live = {p.pid for p in procs}
            for gone in [k for k in cwd_cache if k not in live]:
                del cwd_cache[gone]
            for gone in [k for k in sess_cache if k not in live]:
                del sess_cache[gone]

        groups = sort_groups(group_procs(procs), SORTS[sort_mode][0])
        # 选择必须锚在「哪一个」上，而不是行号上。
        # 列表按内存排序，而内存每帧都在变，行号会自己漂 —— 实测抓屏时两个 ↓ 之间
        # 顺序就变了一次，结果选中项不是用户以为的那一行。这不只是面板显示错乱：
        # k 是按 plist[dsel] 杀的，漂移会杀掉错的进程。
        if rescanned and sel_key is not None:
            sel = next((i for i, g in enumerate(groups) if g.harness.key == sel_key), sel)
        sel = max(0, min(sel, len(groups) - 1))
        if groups:
            sel_key = groups[sel].harness.key
        dgroups = groups

        stdscr.erase()
        h, w = stdscr.getmaxyx()
        mem = sys_mem()

        # ---- 标题栏
        title = f" control agent "
        try:
            stdscr.addstr(0, 0, title, attr(C_TITLE, curses.A_BOLD))
            right = (f"内存 {fmt_bytes(mem['total'])} | 已用 {fmt_bytes(mem['used'])}"
                     f" | 压缩 {fmt_bytes(mem.get('compressor', 0))} ")
            rw, tw = dwidth(right), dwidth(title)
            if rw < w - tw - 2:
                stdscr.addstr(0, w - rw - 1, right, attr(C_DIM))
            # 只画到 w-1：写到最后一个单元格会让 curses 抛错
            stdscr.addstr(1, 0, "-" * max(0, w - 1), attr(C_DIM))
        except curses.error:
            pass

        y = 2
        if detail_of is None:
            # ---- 分组视图
            hdr = ("  " + dpad("HARNESS", 16) + dpad("进程", 5, True)
                   + dpad("内存", 11, True) + dpad("CPU", 8, True) + "   占用分布")
            try:
                stdscr.addstr(y, 0, dtrunc(hdr, w - 1), attr(C_DIM)); y += 1
                stdscr.addstr(y, 0, "  " + "-" * max(0, w - 5), attr(C_DIM)); y += 1
            except curses.error:
                pass

            top_rss = max((g.rss_kb for g in groups), default=0)
            bar_w = max(8, min(24, w - 62))
            for i, g in enumerate(groups):
                if y >= h - 3:
                    break
                n = len(g.procs)
                if n:
                    mems, cpus = fmt_mb(g.rss_kb), f"{g.cpu:.1f}%"
                    np_ = g.protected_count
                    if np_ == n:
                        tail = "全部受保护（当前会话）"
                    elif np_:
                        tail = f"{np_} 个受保护"
                    else:
                        tail = ""
                else:
                    mems = cpus = "-"
                    tail = "未运行"
                line = ("  " + dpad(g.harness.label, 16)
                        + dpad(str(n) if n else "-", 5, True)
                        + dpad(mems, 11, True) + dpad(cpus, 8, True) + "   ")
                lw = dwidth(line)
                selected = (i == sel)
                try:
                    stdscr.addstr(y, 0, dtrunc(line, w - 1),
                                  attr(C_SEL) if selected else 0)
                    if n and bar_w > 4 and lw + bar_w < w - 1:
                        draw_bar(stdscr, y, lw, bar_w,
                                 g.rss_kb / top_rss if top_rss else 0,
                                 C_WARN if g.protected_count else C_OK)
                    if tail and lw + bar_w + dwidth(tail) + 2 < w - 1:
                        stdscr.addstr(y, lw + bar_w + 1, tail, attr(C_DIM))
                except curses.error:
                    pass
                y += 1
        else:
            # ---- 进程明细视图
            g = next((x for x in groups if x.harness.key == detail_of), None)
            try:
                dtitle = f"  > {g.harness.label} 的进程（{len(g.procs)}）" if g else ""
                # 表头列必须和数据行逐列对齐：数据行有 [保护] 这一列，表头漏掉的话
                # 「路径」会压在 [保护] 上方，看着像排版坏了。
                dhdr = ("  " + dpad("PID", 7, True) + dpad("内存", 11, True)
                        + dpad("CPU", 8, True) + "  "
                        + dpad("运行时长", 11) + dpad("保护", 7) + "工作目录")
                stdscr.addstr(y, 0, dtrunc(dtitle, w - 1), attr(C_TITLE)); y += 1
                stdscr.addstr(y, 0, dtrunc(dhdr, w - 1), attr(C_DIM)); y += 1
                stdscr.addstr(y, 0, "  " + "-" * max(0, w - 5), attr(C_DIM)); y += 1
            except curses.error:
                pass
            plist = sorted(g.procs, key=lambda p: -p.rss_kb) if g else []
            # 同主列表：锚 pid 而不是行号，否则内存一波动选中项就换人了。
            # 同样只在重采过的那一帧锚，否则 ↓ 会被立刻抵消。
            if rescanned and dsel_pid is not None:
                dsel = next((i for i, p in enumerate(plist) if p.pid == dsel_pid), dsel)
            dsel = max(0, min(dsel, len(plist) - 1))
            if plist:
                dsel_pid = plist[dsel].pid
            dplist = plist
            # 面板要占地方，列表得先给它让出 PANEL_H 行，否则行数一多面板就被挤出屏幕
            rows_h = h - 3 - (PANEL_H if show_panel else 0)
            # 滚动：保证选中行可见（面板吃掉几行后，选中行滚出屏幕的可能性变大了）
            if dsel < dtop:
                dtop = dsel
            elif rows_h > 0 and dsel >= dtop + rows_h:
                dtop = dsel - rows_h + 1
            dtop = max(0, min(dtop, max(0, len(plist) - rows_h)))
            for i, p in enumerate(plist[dtop:dtop + max(0, rows_h)]):
                i += dtop
                # 用 [保护] 而不是 emoji：emoji 显示宽度不定，且不是所有终端都能渲染
                # 显示工作目录而不是 comm：claude 的 comm 只是个裸名 "claude"，
                # 目录才能说明这个进程在哪个项目里干活
                line = ("  " + dpad(str(p.pid), 7, True) + dpad(fmt_mb(p.rss_kb), 11, True)
                        + dpad(f"{p.cpu:.1f}%", 8, True) + "  "
                        + dpad(p.etime, 11) + dpad("[保护]" if p.protected else "", 7)
                        + (cwd_cache.get(p.pid) or p.comm))
                try:
                    stdscr.addstr(y, 0, dtrunc(line, w - 1), attr(C_SEL) if i == dsel else 0)
                except curses.error:
                    pass
                y += 1

            if show_panel and plist and y < h - 3:
                sp = plist[dsel]
                # 必须写成 if，不能用 dict.setdefault —— setdefault 的第二个参数
                # 总会被求值，那等于每帧都跑一次 15-30ms 的会话解析。
                if sp.pid not in sess_cache:
                    cwd = cwd_cache.get(sp.pid) or proc_cwd(sp.pid)
                    cwd_cache[sp.pid] = cwd
                    sess_cache[sp.pid] = session_panel(sp, cwd)
                y = draw_session_panel(stdscr, y, w, sess_cache[sp.pid],
                                       cwd_cache.get(sp.pid, ""))

        # ---- 状态栏
        if status and time.time() < status_until:
            try:
                stdscr.addstr(h - 2, 0, dtrunc(status, w - 1), attr(C_WARN))
            except curses.error:
                pass
        try:
            if detail_of is None:
                keys = (f"  方向键 选择   Enter 明细   k 杀掉选中   "
                        f"s 排序({SORTS[sort_mode][1]})   H 历史   r 刷新   q 退出")
            else:
                keys = (f"  方向键 选择   k 杀掉选中进程   t 会话面板"
                        f"({'开' if show_panel else '关'})   Esc/q 返回")
            stdscr.addstr(h - 1, 0, dtrunc(keys, w - 1), attr(C_TITLE))
        except curses.error:
            pass
        stdscr.refresh()

        # ---- 输入
        ch = stdscr.getch()
        if ch == -1:
            continue
        if ch == curses.KEY_RESIZE:
            continue

        if ch in (ord("q"), 27, curses.KEY_LEFT):
            if detail_of is not None:
                detail_of = None
                dsel_pid = None
            else:
                return
            continue

        # 移动只用方向键：k 已经分配给「杀」，再让 j/k 兼做移动会和杀操作撞车
        if ch == curses.KEY_UP:
            if detail_of is None:
                sel -= 1
            else:
                dsel -= 1
        elif ch == curses.KEY_DOWN:
            if detail_of is None:
                sel += 1
            else:
                dsel += 1
        if ch in (curses.KEY_UP, curses.KEY_DOWN):
            # 把锚点同步到「刚选中的那一项」。不同步的话，下一帧若恰好碰上重采，
            # 锚定会按**移动前**的 pid 把行号算回去，这一次按键就被吃掉了 ——
            # 2 秒刷新间隔下约等于每两次按 ↓ 丢一次。
            if detail_of is None:
                sel = max(0, min(sel, len(dgroups) - 1))
                if dgroups:
                    sel_key = dgroups[sel].harness.key
            else:
                dsel = max(0, min(dsel, len(dplist) - 1))
                if dplist:
                    dsel_pid = dplist[dsel].pid
        elif ch == ord("s"):
            sort_mode = (sort_mode + 1) % len(SORTS)
            status = f"排序：{SORTS[sort_mode][1]}"
            status_until = time.time() + 1.5
        elif ch == ord("t"):
            show_panel = not show_panel
            status = f"会话面板：{'开' if show_panel else '关'}"
            status_until = time.time() + 1.5
        elif ch == ord("H"):
            # 大写 H：h 小写留给未来的移动键，H 也是 vim 里「History」的直觉位置
            return "history"
        elif ch == ord("r"):
            procs = scan()
            last_scan = time.time()
            # 会话是活的：手动刷新时一并丢掉面板缓存，否则 token 数会一直停在旧值
            sess_cache.clear()
            status = "已刷新"
            status_until = time.time() + 1.0
        elif ch in (10, 13, curses.KEY_RIGHT, ord("l")):
            if detail_of is None:
                if groups[sel].procs:
                    detail_of = groups[sel].harness.key
                    dsel = 0
                    dsel_pid = None
                    dtop = 0
                    # 在这里一次查完，而不是渲染时按需查：每帧几十毫秒会明显卡
                    for p in groups[sel].procs[:CWD_LOOKUP_MAX]:
                        cwd_cache.setdefault(p.pid, proc_cwd(p.pid))
        elif ch == ord("k"):
            if detail_of is None:
                g = groups[sel]
                killable = [p for p in g.procs if not p.protected]
                if not g.procs:
                    status, status_until = "该 harness 未运行", time.time() + 2
                elif not killable:
                    status = "受保护：这些进程属于当前会话，杀掉会终止你自己"
                    status_until = time.time() + 3
                else:
                    skipped = len(g.procs) - len(killable)
                    msg = f"杀掉 {g.harness.label} 的 {len(killable)} 个进程？"
                    if skipped:
                        msg += f"\n（跳过 {skipped} 个受保护的当前会话进程）"
                    if confirm(stdscr, msg):
                        gone, errs = kill_pids([p.pid for p in killable])
                        procs = scan()
                        last_scan = time.time()
                        status = f"已终止 {len(gone)} 个"
                        if errs:
                            status += f"；{len(errs)} 个失败：{errs[0]}"
                        status_until = time.time() + 4
                    else:
                        status, status_until = "已取消", time.time() + 1.5
            else:
                g = next((x for x in groups if x.harness.key == detail_of), None)
                plist = sorted(g.procs, key=lambda p: -p.rss_kb) if g else []
                if plist:
                    p = plist[dsel]
                    if p.protected:
                        status = "受保护：这是当前会话的进程，杀掉会终止你自己"
                        status_until = time.time() + 3
                    elif confirm(stdscr, f"杀掉 pid {p.pid}？\n{p.comm}"):
                        gone, errs = kill_pids([p.pid])
                        procs = scan()
                        last_scan = time.time()
                        status = f"已终止 {len(gone)} 个" + (f"；{errs[0]}" if errs else "")
                        status_until = time.time() + 4
                        if not gone:
                            detail_of = None
                            dsel_pid = None
                    else:
                        status, status_until = "已取消", time.time() + 1.5


# ---------------------------------------------------------------- 历史会话 TUI

H_SORTS = [("mtime", "时间新→旧"), ("mtime_asc", "时间旧→新"), ("size", "大小")]
H_PANEL_H = 8           # 详情面板预留行数（与 agent 视图的 PANEL_H 对齐）
H_LOAD_PER_FRAME = 2    # 每帧最多解析几个会话文件（单个 15-100ms，多了按键会发粘）


# ------------------------------------------------------------ 恢复会话确认框
#
# 模型候选不写死 id：从用户自己的 ~/.claude/settings.json 读，也就是 /model 选择器
# 里那几条「Custom Opus/Sonnet/Haiku/Fable model」。写死在这里没有意义 —— 同一份
# 配置在不同机器上映射到完全不同的模型（glm-5.3-highspeed / deepseek-v4-flash / …）。
MODEL_SLOTS = (("opus", "ANTHROPIC_DEFAULT_OPUS_MODEL"),
               ("sonnet", "ANTHROPIC_DEFAULT_SONNET_MODEL"),
               ("haiku", "ANTHROPIC_DEFAULT_HAIKU_MODEL"),
               ("fable", "ANTHROPIC_DEFAULT_FABLE_MODEL"))
# 授权模式。None = 不传旗标，用 claude 自己的默认（含用户 settings 里配的那个）
RESUME_MODES = [None, "auto", "bypassPermissions"]
RESUME_MODE_LABEL = {None: "默认", "auto": "auto", "bypassPermissions": "允许一切"}
RESUME_MODE_HINT = {None: "不传旗标，用 claude 的默认",
                    "auto": "低风险操作自动放行",
                    "bypassPermissions": "全部放行，不再询问"}
RESUME_DEFAULT_MODE = "auto"        # 没有历史偏好时预选的模式
RESUME_BOX_W = 84                   # 确认框宽度上限：再窄「将执行」那行会被截得看不懂
# 选项右侧说明文字的对齐列。模型行的值都是短别名，最长的标签就是「沿用会话原模型」
RESUME_HINT_X = 12 + dwidth("< 沿用会话原模型 >") + 3
RESUME_PREFS = os.path.expanduser("~/.cache/haruka-control/resume-prefs")


def claude_settings_env() -> dict:
    """
    读 ~/.claude/settings.json（以及可选的 settings.local.json，后者覆盖前者）的 env。

    /model 选择器里那些「Custom Xxx model」条目就来自这里：用户把别名槽位
    （opus / sonnet / haiku / fable）映射到自己的模型上。读不到就当什么都没配。
    """
    env = {}
    for name in ("settings.json", "settings.local.json"):
        try:
            with open(os.path.join(CLAUDE_DIR, name), encoding="utf-8") as f:
                env.update(json.load(f).get("env") or {})
        except (OSError, ValueError, AttributeError):
            continue        # 文件不在 / 不是合法 JSON / 顶层不是对象，都当没配
    return env


def resume_model_choices(cur: str = "") -> list:
    """
    确认框里模型行的候选项：[(传给 --model 的值, 显示标签, 右侧说明), ...]。

    第 0 项固定是「沿用会话原模型」（值为 None，不传 --model）。

    其余来自用户配置，传的是**别名**（opus/sonnet/haiku/fable）而不是配置里的原始
    模型串：别名由 claude 自己按 env 映射解析，和 /model 选择器走同一条路；把
    "glm-5.3-highspeed[1M]" 这种带 [1M] 后缀的串直接塞给 --model 语义不明。
    别名看不出实际用哪个模型，所以右边的说明写它解析成什么 —— 注意两个槽位映射到
    同一个模型是常态（比如 opus 和 sonnet 都指向 glm-5.3-highspeed），
    这也是别名必须当主标签、模型名只能当说明的原因。
    """
    env = claude_settings_env()
    out = [(None, "沿用会话原模型", f"会话当前 {cur}" if cur else "")]
    for alias, key in MODEL_SLOTS:
        raw = env.get(key)
        if raw:
            # *_NAME 是给人看的名（已去掉 [1M] 之类的后缀），没有就退回原始值
            out.append((alias, alias, env.get(key + "_NAME") or raw))
    if len(out) == 1:               # settings 里一个槽位都没配：退回裸别名
        out += [(a, a, "") for a, _ in MODEL_SLOTS]
    return out


def load_resume_prefs() -> dict:
    """读上次的模型 / 模式选择。文件缺失或坏掉都当没有 —— 一个偏好文件不值得挡路。"""
    try:
        with open(RESUME_PREFS, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_resume_prefs(model: str | None, mode: str | None) -> None:
    """记下这次的选择，下次进确认框时预选。先写 .new 再替换，免得留下半截 JSON。"""
    try:
        os.makedirs(os.path.dirname(RESUME_PREFS), exist_ok=True)
        tmp = RESUME_PREFS + ".new"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump({"model": model, "mode": mode}, f)
        os.replace(tmp, RESUME_PREFS)
    except OSError:
        pass            # 目录只读之类：记不住就算了，不影响恢复会话本身


def resume_argv(claude_bin: str, sid: str,
                model: str | None, mode: str | None) -> list:
    """拼 claude --resume 的完整参数。没选的那项就不传，不塞空值进去。"""
    argv = [claude_bin, "--resume", sid]
    if model:
        argv += ["--model", model]
    if mode:
        argv += ["--permission-mode", mode]
    return argv


def resume_dialog(stdscr, row: SessionRow):
    """
    Enter 之后的确认框：先定「用哪个模型」和「授权模式」，回车才真的恢复会话。

    返回 (model, mode)；Esc / q 取消返回 None。两者为 None 表示不传对应旗标。

    为什么要在 exec 之前停下来问：--resume 进去就是一个真实对话，模型选错要么贵
    要么笨，模式选错直接决定 claude 动不动手前问你。这两件事都值得在终端还握在
    我们手里时确认一次 —— exec 一旦换出进程就再也收不回来了。

    选项按上次的选择预选（resume-prefs），常用组合不必每次重选，但每次都还能改。
    取消不写 prefs，也不动终端，直接回列表。
    """
    # 会话当前用的模型名：让「沿用会话原模型」和某个具体槽位的差别看得见
    cur = ""
    st = row.stats
    if st is None or st.get("failed"):
        st = session_stats(row.sid, row.path)
    if st and not st.get("failed"):
        cur = st.get("model") or ""

    models = resume_model_choices(cur)          # [(值, 标签, 说明), ...]，第 0 项是「沿用」
    prefs = load_resume_prefs()
    try:
        mi = [m[0] for m in models].index(prefs.get("model"))
    except ValueError:
        mi = 0                                  # 偏好里的模型已不在配置里，退回「沿用」
    try:
        pi = RESUME_MODES.index(prefs.get("mode", RESUME_DEFAULT_MODE))
    except ValueError:
        pi = RESUME_MODES.index(RESUME_DEFAULT_MODE)
    focus = 0                                   # 0 = 模型行，1 = 模式行

    while True:
        model, mode = models[mi][0], RESUME_MODES[pi]
        h, w = stdscr.getmaxyx()
        box_w, box_h = min(RESUME_BOX_W, w - 2), 11
        if box_w < 40 or box_h > h:
            return None                         # 窗口太小，画不下就别硬画
        try:
            win = curses.newwin(box_h, box_w, max(0, (h - box_h) // 2),
                                max(0, (w - box_w) // 2))
        except curses.error:
            return None
        win.bkgd(" ", attr(C_SEL))              # 和 confirm() 一致：整块反白底
        # keypad 必须单独开：newwin 出来的窗口不继承 stdscr 的设置，不开的话方向键
        # 会原样吐 ESC + "[C"，而 ESC 在下面正好是「取消」—— 按一下右键就把框关了
        win.keypad(True)
        win.box()

        def put(y: int, text: str, x: int = 2, pair: int = C_SEL, extra: int = 0) -> None:
            if x >= box_w - 1:                  # 右边放不下了，宁可不画也别越界
                return
            try:
                win.addstr(y, x, dtrunc(text, box_w - 1 - x), attr(pair, extra))
            except curses.error:
                pass

        # 结构性字符一律 ASCII：`-` 而不是 `─`、`<` `>` 而不是 `◂ ▸`。
        # 歧义宽度字符（─ ↑ ◂ 等 EAW=Ambiguous）会被某些终端按 2 列渲染，
        # 而代码按 1 列算，整块版面就散了 —— 详见 README「终端兼容性」。
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(row.mtime))
        put(1, f"恢复会话 {row.sid[:8]}", extra=curses.A_BOLD)
        if box_w >= 52:                         # 窄终端里时间会压到标题上，干脆不画
            put(1, when, box_w - 2 - len(when), extra=curses.A_DIM)
        put(2, row.project.replace(os.path.expanduser("~"), "~", 1), extra=curses.A_DIM)
        put(3, "-" * (box_w - 4), extra=curses.A_DIM)

        # 两行选项：焦点行标黄，`< >` 提示可以左右改值
        for i, (label, value, hint) in enumerate((
                ("模型", models[mi][1], models[mi][2]),
                ("模式", RESUME_MODE_LABEL[mode], RESUME_MODE_HINT[mode]))):
            pair = C_WARN if focus == i else C_SEL
            put(4 + i, label, 4, pair, curses.A_BOLD)
            put(4 + i, f"< {value} >", 12, pair)
            if hint and box_w - RESUME_HINT_X >= 12:
                put(4 + i, hint, RESUME_HINT_X, pair, curses.A_DIM)   # 挤不下就整句不画

        put(6, "-" * (box_w - 4), extra=curses.A_DIM)
        # 把真正要跑的命令摊开：会话 id 独占一行，旗标另起一行，窄终端也读得全
        flags = resume_argv("claude", row.sid, model, mode)[3:]
        put(7, "将执行  claude --resume " + row.sid, extra=curses.A_BOLD)
        put(8, "        " + (" ".join(flags) if flags else "不加额外旗标"),
            extra=curses.A_BOLD if flags else curses.A_DIM)
        put(9, "方向键 上下换行 左右改值   Enter 恢复会话   Esc 取消", extra=curses.A_DIM)
        win.refresh()

        ch = win.getch()
        if ch == curses.KEY_RESIZE:
            continue
        if ch in (27, ord("q")):
            return None
        if ch == curses.KEY_UP:
            focus = (focus - 1) % 2
        elif ch == curses.KEY_DOWN:
            focus = (focus + 1) % 2
        elif ch == curses.KEY_LEFT:
            if focus == 0:
                mi = (mi - 1) % len(models)
            else:
                pi = (pi - 1) % len(RESUME_MODES)
        elif ch == curses.KEY_RIGHT:
            if focus == 0:
                mi = (mi + 1) % len(models)
            else:
                pi = (pi + 1) % len(RESUME_MODES)
        elif ch in (10, 13):
            save_resume_prefs(model, mode)
            return model, mode


def resume_session(stdscr, row: SessionRow, claude_bin: str,
                   model: str | None = None, mode: str | None = None) -> None:
    """
    Enter 确认后恢复会话：还原终端后 exec claude --resume <sid>，直接落进那个对话。

    model / mode 来自确认框（resume_dialog），None 表示不传对应旗标。

    为什么用 exec 而不是 subprocess：TUI 的使命到此为止，进程应该被直接换掉 ——
    subprocess 要等 claude 退出再收尾，用户退出 claude 后还会落回这个空壳 python。
    exec 换出后，claude 退出时用户看到的就是原本的 shell，和手敲
    claude --resume 的体验完全一致。

    必须先手工还原终端：curses.wrapper 的还原代码在 finally 里，而 exec 不走
    finally，直接换进程会把终端留在 raw 模式（无回显、无行缓冲）。

    项目目录优先用 history.jsonl 的原始路径；目录已被删掉时再读会话文件头部的
    cwd 记录；两条路都失败就在当前目录起 claude —— 会话 id 全局唯一，
    --resume 不依赖 cwd 也能定位到会话。
    """
    cwd = row.project if os.path.isdir(row.project) else session_cwd_from_file(row.path)
    try:
        curses.curs_set(1)
    except curses.error:
        pass
    try:
        curses.echo()
        curses.nocbreak()
        stdscr.keypad(False)
        curses.endwin()
    except curses.error:
        pass
    if cwd and os.path.isdir(cwd):
        os.chdir(cwd)
    argv = resume_argv(claude_bin, row.sid, model, mode)
    print(f"\n→ {' '.join(['claude'] + argv[1:])}"
          + (f"   (in {cwd})" if cwd else ""), flush=True)
    try:
        os.execvp(claude_bin, argv)
    except OSError as e:
        # exec 失败时终端已还原，直接报错退出；为回 TUI 而重建 curses 不值当
        print(f"启动 claude 失败: {e}", file=sys.stderr)
        raise SystemExit(1)


def draw_history_panel(stdscr, y: int, w: int, r: SessionRow) -> int:
    """画选中会话的详情面板，返回下一行的 y。结构对齐 agent 视图的会话面板。"""
    def put(text: str, pair: int = 0) -> None:
        nonlocal y
        try:
            stdscr.addstr(y, 0, dtrunc(text, w - 1), attr(pair))
        except curses.error:
            pass
        y += 1

    put(f"  --- {r.sid[:8]}   {r.project} ---", C_TITLE)
    if r.stats is None:
        put("  统计加载中…", C_DIM)
        return y
    if r.stats.get("failed"):
        put("  （这个会话文件解析失败）", C_WARN)
        return y
    tok = r.stats["tokens"]
    put("  " + f"模型 {r.stats['model']}   消息 {r.stats['msgs']}"
        + "   输入 " + fmt_tokens(tok["input_tokens"])
        + "   输出 " + fmt_tokens(tok["output_tokens"]))
    put("  缓存读 " + fmt_tokens(tok["cache_read_input_tokens"])
        + "   缓存写 " + fmt_tokens(tok["cache_creation_input_tokens"])
        + "   合计 " + fmt_tokens(sum(tok.values())) + " tokens", C_DIM)
    meaningful = [d for d in r.prompts if not str(d).lstrip().startswith("/")]
    if meaningful:
        put("  最近提问", C_DIM)
        for entry in meaningful[-PROMPT_ROWS:]:
            text = next((ln.strip() for ln in str(entry).splitlines() if ln.strip()), "")
            put(f"    {text}")
    return y


def history_tui(stdscr, back_to_agent: bool):
    curses.curs_set(0)
    init_colors()
    # 历史列表是静态数据，不需要 agent 视图那种 2s 重采；120ms 的超时只是为了
    # 让懒加载和状态消息的过期有机会推进。按键是即时返回的，不用等满超时。
    stdscr.timeout(120)

    rows = collect_sessions()
    query = ""
    typing = False          # 是否在搜索输入模式
    pending = b""           # 收到一半的 UTF-8 多字节序列
    sel, top = 0, 0
    sel_sid: str | None = None
    hsort = 0
    show_panel = True
    status, status_until = "", 0.0
    view: list[SessionRow] = rows

    while True:
        # ---- 过滤 + 排序（搜索打字时要实时刷新视图）
        keyf = {"mtime": lambda r: -r.mtime,
                "mtime_asc": lambda r: r.mtime,
                "size": lambda r: -r.size}[H_SORTS[hsort][0]]
        view = sorted((r for r in rows if row_match(r, query)), key=keyf)
        # 选择锚定在 sid 上而不是行号上：排序 / 过滤都会重排列表，
        # 锚行号会让选择滑到不相干的行（agent 视图同理，见那里的说明）
        if sel_sid is not None:
            sel = next((i for i, r in enumerate(view) if r.sid == sel_sid),
                       min(sel, max(0, len(view) - 1)))
        sel = max(0, min(sel, max(0, len(view) - 1)))
        sel_sid = view[sel].sid if view else None

        # ---- 懒加载：选中行优先（详情面板要用），再补可见行的标题。
        # 打字时跳过：一次 15-100ms 的文件解析会让按键明显发粘
        h, w = stdscr.getmaxyx()
        rows_h = max(1, h - 6 - (H_PANEL_H if show_panel and view else 0))
        if not typing and view:
            want = []
            if view[sel].stats is None:
                want.append(view[sel])
            for r in view[top:top + rows_h]:
                if len(want) >= H_LOAD_PER_FRAME:
                    break
                if r.stats is None and r is not view[sel]:
                    want.append(r)
            for r in want:
                st = session_stats(r.sid, r.path)
                if st is None:
                    r.stats = {"failed": True}   # 解析失败也标记上，别每帧重试
                else:
                    r.stats = st
                    if st.get("title") and st["title"] != r.title:
                        r.title = st["title"]
                        r.hay = ""               # 标题变了，搜索索引要重建

        # ---- 渲染
        stdscr.erase()
        title = f" claude 会话历史（{len(view)}/{len(rows)}） "
        try:
            stdscr.addstr(0, 0, dtrunc(title, w - 1), attr(C_TITLE, curses.A_BOLD))
            right = f"{H_SORTS[hsort][1]} "
            if dwidth(right) < w - dwidth(title) - 2:
                stdscr.addstr(0, w - dwidth(right) - 1, right, attr(C_DIM))
            stdscr.addstr(1, 0, "-" * max(0, w - 1), attr(C_DIM))
        except curses.error:
            pass

        y = 2
        when_w, proj_w, size_w = 12, 26, 9
        title_w = max(12, w - 2 - when_w - proj_w - size_w - 3)
        hdr = ("  " + dpad("时间", when_w) + dpad("标题 / 最近提问", title_w)
               + dpad("项目", proj_w) + dpad("大小", size_w, True))
        try:
            stdscr.addstr(y, 0, dtrunc(hdr, w - 1), attr(C_DIM)); y += 1
            stdscr.addstr(y, 0, "  " + "-" * max(0, w - 5), attr(C_DIM)); y += 1
        except curses.error:
            pass

        # 滚动：保证选中行可见（与 agent 详情视图同一套逻辑）
        if sel < top:
            top = sel
        elif sel >= top + rows_h:
            top = sel - rows_h + 1
        top = max(0, min(top, max(0, len(view) - rows_h)))

        for i in range(top, min(len(view), top + rows_h)):
            when, text, proj = row_text(view[i])
            text = next((ln.strip() for ln in text.splitlines() if ln.strip()), "")
            line = ("  " + dpad(when, when_w) + dpad(dtrunc(text, title_w), title_w)
                    + dpad(dtrunc(proj, proj_w), proj_w)
                    + dpad(fmt_bytes(view[i].size), size_w, True))
            try:
                stdscr.addstr(y, 0, dtrunc(line, w - 1),
                              attr(C_SEL) if i == sel else 0)
            except curses.error:
                pass
            y += 1
        if not view:
            try:
                stdscr.addstr(y, 0, dtrunc("  （没有匹配的会话）", w - 1), attr(C_WARN))
                y += 1
            except curses.error:
                pass

        if show_panel and view and y < h - 3:
            y = draw_history_panel(stdscr, y, w, view[sel])

        # ---- 状态栏
        if status and time.time() < status_until:
            try:
                stdscr.addstr(h - 2, 0, dtrunc(status, w - 1), attr(C_WARN))
            except curses.error:
                pass
        try:
            if typing:
                # 用下划线当假光标：curses 里精确定位真光标麻烦，也没必要
                stdscr.addstr(h - 1, 0, dtrunc("  / " + query + "_", w - 1), attr(C_WARN))
            else:
                keys = (f"  Enter 恢复会话   / 搜索   s 排序({H_SORTS[hsort][1]})"
                        f"   t 详情   PgUp/PgDn 翻页   r 重扫"
                        f"   {'Esc 返回' if back_to_agent else 'q 退出'}")
                stdscr.addstr(h - 1, 0, dtrunc(keys, w - 1), attr(C_TITLE))
        except curses.error:
            pass
        stdscr.refresh()

        # ---- 输入
        ch = stdscr.getch()
        if ch == -1 or ch == curses.KEY_RESIZE:
            continue

        if typing:
            if ch in (10, 13):                      # Enter：确认搜索，保留过滤
                typing, pending = False, b""
            elif ch == 27:                          # Esc：清空过滤
                typing, pending, query = False, b"", ""
                sel, sel_sid = 0, None
            elif ch in (8, 127, curses.KEY_BACKSPACE):
                if pending:
                    pending = b""                   # 只删掉凑了一半的多字节字符
                elif query:
                    query = query[:-1]
            elif 32 <= ch < 256:
                pending += bytes([ch])
                try:
                    query += pending.decode("utf-8")
                    pending = b""
                except UnicodeDecodeError:
                    pass                            # 中文占 3 字节，等后两个到齐
            continue

        if ch in (ord("q"), 27, curses.KEY_LEFT):
            # Esc 在从 agent 视图进来时是「返回上一层」，直接启动时就是退出
            if ch != ord("q") and back_to_agent:
                return "agent"
            return None
        if ch == curses.KEY_UP:
            sel -= 1
        elif ch == curses.KEY_DOWN:
            sel += 1
        elif ch == curses.KEY_PPAGE:
            sel -= rows_h
        elif ch == curses.KEY_NPAGE:
            sel += rows_h
        elif ch in (curses.KEY_HOME, ord("g")):
            sel = 0
        elif ch in (curses.KEY_END, ord("G")):
            sel = len(view) - 1
        if ch in (curses.KEY_UP, curses.KEY_DOWN, curses.KEY_PPAGE,
                  curses.KEY_NPAGE, curses.KEY_HOME, curses.KEY_END,
                  ord("g"), ord("G")):
            # 锚点跟着移动走，否则下一帧的锚定会按移动前的 sid 把行号算回去
            sel = max(0, min(sel, max(0, len(view) - 1)))
            if view:
                sel_sid = view[sel].sid
        elif ch == ord("/"):
            typing, pending = True, b""
        elif ch == ord("s"):
            hsort = (hsort + 1) % len(H_SORTS)
        elif ch == ord("t"):
            show_panel = not show_panel
        elif ch == ord("r"):
            rows = collect_sessions()
            status, status_until = f"已重扫：{len(rows)} 个会话", time.time() + 2
        elif ch in (10, 13, curses.KEY_RIGHT, ord("l")):
            if view:
                claude_bin = shutil.which("claude")
                if not claude_bin:
                    status = "PATH 里找不到 claude，无法恢复会话"
                    status_until = time.time() + 3
                else:
                    pick = resume_dialog(stdscr, view[sel])
                    if pick is not None:        # Esc 取消就留在列表里，什么都不动
                        # 成功 exec 就再也不返回了
                        resume_session(stdscr, view[sel], claude_bin, pick[0], pick[1])


def main() -> int:
    args = sys.argv[1:]
    # 子命令 history —— 浏览历史会话；其余 --xxx 旗标沿用 agent 视图的解析
    start = "history" if args and args[0] == "history" else "agent"
    if start == "history":
        args = args[1:]

    interval = 2.0
    if "--interval" in args:
        i = args.index("--interval")
        try:
            interval = float(args[i + 1])
        except (IndexError, ValueError):
            print("--interval 需要数字", file=sys.stderr)
            return 2

    if start == "history":
        # 与 agent 视图同一约定：管道里自动退化成一次性表格
        if "--once" in args or not sys.stdout.isatty():
            print_history_table(collect_sessions())
            return 0
    else:
        procs = scan()
        if "--list" in args:
            print_list()
            return 0
        if "--json" in args:
            print_json(procs)
            return 0
        if "--once" in args or not sys.stdout.isatty():
            print_table(procs)
            return 0

    # 两个视图可互相跳转（agent --H--> history --Esc--> agent），每次跳转都完整
    # 走一遍 curses 的 init/teardown，不共用屏幕状态
    try:
        view, from_agent = start, False
        while view:
            if view == "agent":
                res = curses.wrapper(lambda s: tui(s, interval))
                view, from_agent = ("history", True) if res == "history" else (None, False)
            else:
                res = curses.wrapper(lambda s: history_tui(s, from_agent))
                view = "agent" if res == "agent" else None
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
